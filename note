to_postgres:
	docker exec -it pipeline-postgres-1 psql -U airflow -d airflow

chown:
	sudo chown -R $USER:$USER .

spark_submit:
	spark-submit \
  --master local \
  --jars ./spark/jars/postgresql-42.7.11.jar,./spark/jars/snowflake-jdbc-3.13.30.jar,./spark/jars/spark-snowflake_2.12-2.12.0-spark_3.4.jar \
  ./spark/src/spark.py

